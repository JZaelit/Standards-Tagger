# Copy this file to .env at the repo root, then fill in your keys.
# .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Gemini (alignment proxy) ----------------------------------------------
# Used by tools/gemini_proxy.py  (run: npm run gemini-proxy).
# Get a key: https://aistudio.google.com/apikey
# Must start with "AIza" (capital I, not lowercase L).
GEMINI_API_KEY=your_key_here

# Port for the local proxy. Optional, defaults to 8787.
#GEMINI_PROXY_PORT=8787

# --- Anthropic (curation pipeline) -----------------------------------------
# Used only by tools/curate.py (Stage 3 of the alignment pipeline).
# Get a key: https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- Supabase --------------------------------------------------------------
# NOT configured here. The project URL and publishable anon key are hardcoded
# in frontend/src/lib/supabase.js. Listed for awareness only.
