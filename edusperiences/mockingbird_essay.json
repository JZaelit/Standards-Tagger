          {
            "id": "c8b77d76-ce8d-4aac-aca3-85cac4dc5714",
            "section_id": "9e1266bf-193b-43f5-abc6-7fdd6f66b111",
            "title": "Subjective AI",
            "description": "Subjective AI Evaluations covering Depth of Analysis, Clarity and Coherence, Engagement and Originality, Use of Textual Evidence, and Emotional and Intellectual Impact.",
            "order": 0,
            "assessmentable": null,
            "evaluation_type": "ai",
            "points": 50,
            "created_at": "2024-12-06T05:10:47.139Z",
            "updated_at": "2024-12-06T05:10:47.139Z",
            "deleted_at": null,
            "resource_attachments": [],
